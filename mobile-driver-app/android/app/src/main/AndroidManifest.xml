<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access - API calls (Dio) and Socket.IO live tracking -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- GPS location - broadcasting driver position during an active trip -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- DELIBERATELY no ACCESS_BACKGROUND_LOCATION - removed 2026-08-16 after
         a real Play Console rejection ("Permissions and APIs that Access
         Sensitive Information policy: Issues with submitted video"). It was
         declared here but never actually requested by any code (no
         Geolocator/permission_handler call anywhere asks for "Allow all the
         time") and isn't needed for what this app does: a foreground service
         with foregroundServiceType="location" (below) can read location
         continuously as long as it's running and the app holds plain
         "while in use" access - Android's own documented exception, and
         exactly how ride-hailing/delivery driver apps do live tracking
         without the background tier. Declaring the permission with no real
         use for it just puts the app in Play Console's mandatory Background
         Location declaration+video review queue for nothing. If a genuine
         need for true background access (reading location with no
         foreground service running at all) ever comes up, re-add this AND
         build a proper in-app prominent-disclosure screen first - Google
         requires that disclosure to exist and be shown before the OS
         permission dialog, or review will reject again regardless of the
         video's production quality. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Camera - selfie capture for KYC and barcode scanning at pickup -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- Android 13+ (API 33) requires this to even show the notification
         permission dialog - without it, FirebaseMessaging.requestPermission()
         silently has nothing to ask for. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Raah Mitr Driver"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Do not rename - flutter_foreground_task's plugin code refers to
             this exact service name. foregroundServiceType="location" is the
             Android 14+ (API 34) requirement for a service that continuously
             accesses device location. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
