# Production env for the VPS - copy to backend/.env on the server and fill
# in real values. Do NOT reuse your local dev .env here: the values below
# are specifically what infra/docker/docker-compose.yml expects (container
# hostnames, container-internal port), not what your laptop uses.

# Server
NODE_ENV=production
PORT=5000
API_VERSION=v1

# MongoDB - 'mongo' is the docker-compose service name, not localhost.
# Containers on the compose network resolve each other by service name.
MONGO_URI=mongodb://mongo:27017/logistics_platform

# Redis - same reasoning, 'redis' is the compose service name.
REDIS_URL=redis://redis:6379

# JWT - generate real random secrets, e.g.: openssl rand -hex 64
# Do not reuse the dev secrets or the placeholders from .env.example.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase (Push Notifications + email/password auth verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMS OTP (MSG91 / Twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@raahmitr.com

# AWS S3 (KYC document storage - see note in driver.controller.js; local
# disk storage plus the uploads_data volume works for a single-VPS pilot,
# switch to S3 before scaling past one node)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=logistics-platform-uploads

# Google Maps
GOOGLE_MAPS_API_KEY=

# CORS - real domains, not localhost
CLIENT_ORIGIN=https://raahmitr.com
ADMIN_ORIGIN=https://raahmitr.com
ENTERPRISE_ORIGIN=https://enterprise.raahmitr.com
