# Production env for the VPS - copy to backend/.env on the server and fill
# in real values. Do NOT reuse your local dev .env here: the values below
# are specifically what infra/docker/docker-compose.yml expects (container
# hostnames, container-internal port), not what your laptop uses.

# Server
NODE_ENV=production
PORT=5000
API_VERSION=v1

# MongoDB - use the real Atlas connection string already in use (do NOT
# point this at a fresh local mongo container, or the app will start
# against an empty database instead of the real data).
MONGO_URI=

# Redis - not wired into the backend anywhere; leave unset unless/until
# real caching is implemented.
REDIS_URL=

# JWT - generate real random secrets, e.g.: openssl rand -hex 64
# Do not reuse the dev secrets or the placeholders from .env.example.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase (Push Notifications + email/password auth verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@raahmitr.com

# AWS S3 (KYC document storage - see note in driver.controller.js; local
# disk storage plus the uploads_data volume works for a single-VPS pilot,
# switch to S3 before scaling past one node)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=logistics-platform-uploads

# Google Maps
GOOGLE_MAPS_API_KEY=

# CORS - matches infra/nginx/nginx.conf's subdomain scheme
# (api.raahmitr.com / raahmitr.com / enterprise.raahmitr.com). Switch to
# https:// once certbot has issued certificates for all three.
CLIENT_ORIGIN=http://raahmitr.com
ADMIN_ORIGIN=http://raahmitr.com
ENTERPRISE_ORIGIN=http://enterprise.raahmitr.com
